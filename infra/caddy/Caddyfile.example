# Phase 2 design-only Caddy reverse-proxy example.
# Not mounted by the fixture Compose stack. Requires real TLS identity,
# an approved DNS hostname, and a hardened Keycloak deployment to activate.
{$AUTOAXE_PUBLIC_HOST} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    -Server
  }
  @backend path /api/*
  handle @backend {
    reverse_proxy api:8000 {
      header_up -X-Forwarded-User
      header_up -X-Client-Certificate
    }
  }
  handle {
    reverse_proxy web:4173
  }
}

# Internal private broker must have a separate verified mTLS listener,
# not a public route through this Caddyfile. Do NOT forward unverified
# X-Client-Certificate headers or expose /internal/* on this domain.
