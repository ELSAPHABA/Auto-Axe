{
  "name": "auto-axe",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "contracts:types": "pnpm --filter @autoaxe/web run contracts:types",
    "typecheck": "pnpm --filter @autoaxe/web typecheck",
    "lint": "pnpm --filter @autoaxe/web lint",
    "format:check": "pnpm --filter @autoaxe/web format:check",
    "test": "pnpm --filter @autoaxe/web test",
    "build": "pnpm --filter @autoaxe/web build",
    "test:e2e": "pnpm --filter @autoaxe/web test:e2e"
  }
}
