# Copy this file to .env and fill your own registered credentials.
# Required for SEC EDGAR: describe your app and provide a reachable contact.
AUTO_AXE_USER_AGENT=AutoAxe Research contact@example.com
# Optional sources, each API key is obtained from the corresponding issuer.
FRED_API_KEY=
EIA_API_KEY=
BLS_API_KEY=
# Example: CPI, total nonfarm payroll employees, unemployment rate
BLS_SERIES=CUUR0000SA0,CES0000000001,LNS14000000
# Paid-only examples discussed in Real_Time_Data_Sources.md
DATABENTO_API_KEY=
MASSIVE_API_KEY=
TRADING_ECONOMICS_API_KEY=
